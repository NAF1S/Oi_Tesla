{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "description": "Express REST API for the TeslaB app",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "ride-requests:expire": "node src/commands/expire-ride-requests.js",
    "dispatch:sweep": "node src/commands/dispatch-sweep.js",
    "pool-fares:recalculate": "node src/commands/recalculate-pool-fares.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/*.test.js\"",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prisma": "^7.10.0"
  }
}
