# Copy to .env and adjust as needed
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# Postgres (docker compose up -d db)
# Note: the container is published on 55432 because a locally installed
# PostgreSQL owns 5432 on this machine.
#
# Shared by the API and the Prisma CLI (prisma7.config.ts reads the same value
# through src/config/env.js). If this file is missing entirely, both fall back
# to the docker-compose defaults, so the API runs with no .env at all.
DATABASE_URL=postgres://postgres:postgres@localhost:55432/TeslaB

# --- Authentication ---------------------------------------------------------
# REQUIRED in production: the server refuses to start with NODE_ENV=production
# unless this is set. In development a clearly-marked insecure default is used
# so that the API still runs with no .env file at all.
JWT_SECRET=change-me-to-a-long-random-string

# Token lifetime in seconds. Drives both the JWT `exp` and the cookie Max-Age.
AUTH_TOKEN_TTL_SECONDS=7200

# Cookie name and attributes. COOKIE_SECURE defaults to true in production.
# Only use COOKIE_SAME_SITE=none (with COOKIE_SECURE=true) if the browser really
# calls the API cross-site; the default 'lax' suits the same-origin proxy setup.
AUTH_COOKIE_NAME=teslab_auth
COOKIE_SAME_SITE=lax
# COOKIE_SECURE=true

# bcrypt work factor. 10 is bcrypt's conventional default; every +1 doubles the
# time (and cost) to hash one password.
BCRYPT_COST=10

# --- Demo seed (DEVELOPMENT ONLY) -------------------------------------------
# The password given to the demo accounts (Nusrat, Rafiq, Shirin, Jashim) by
# `npm run db:seed`. See the README: these accounts must never be seeded in
# production. The seeder refuses to run there unless ALLOW_DEMO_SEED=true, and
# then it also requires DEMO_SEED_PASSWORD to be set explicitly.
DEMO_SEED_PASSWORD=DemoPass123!
# ALLOW_DEMO_SEED=true

# --- Routing ----------------------------------------------------------------
# The Asia/Dhaka rush-hour windows that decide whether a route estimate uses
# normal or rush-hour costs. Comma-separated HH:MM-HH:MM ranges; a window whose
# end is not after its start wraps past midnight (e.g. 22:00-02:00).
#
# A window is half-open: the start minute counts as rush hour, the end minute
# does not. With the value below, 07:29 is normal, 07:30-10:29 is rush hour and
# 10:30 is normal again.
#
# A malformed value stops the server at start-up rather than silently estimating
# every route with the wrong costs.
RUSH_HOUR_WINDOWS=07:30-10:30,16:30-20:00

# PostgreSQL statement_timeout applied to the pgRouting queries, in milliseconds.
# The guard exists so a runaway routing query cannot hold a connection open.
ROUTING_STATEMENT_TIMEOUT_MS=5000

# Prisma's own ceiling for the routing transaction, in milliseconds. Kept above
# the statement timeout so the database reports the failure first.
ROUTING_QUERY_TIMEOUT_MS=10000

# --- Fare pricing -----------------------------------------------------------
# The pricing policy code fare quotes are calculated with. The code -- and
# therefore the price -- is chosen by the server, never by a client: a request
# has no field that could select a policy.
#
# The *version* is not configured: it is whichever version of this code is
# effective at the journey's departure instant, so publishing a new price is a
# data change (insert the next version), not a deployment.
FARE_PRICING_CODE=dhaka-solo

# --- Ride requests ----------------------------------------------------------
# How long a WAITING ride request looks for a ride before its search window
# closes. Drives `search_expires_at = requested_at + this`, and is the deadline
# the expiration sweep (`npm run ride-requests:expire`) acts on.
#
# Changing this affects only requests created after the change: the deadline is
# stored on each request when it is created, so existing requests keep the
# window they were given.
RIDE_REQUEST_SEARCH_TTL_SECONDS=600

# Ceiling for the interactive transaction a ride-request write runs in. Creating
# or cancelling a request updates the row and appends its event in one
# transaction, and creating one also waits on the quote's row lock, so this
# covers a lock wait plus two writes.
RIDE_REQUEST_TRANSACTION_TIMEOUT_MS=10000

# Default page size for `GET /api/ride-requests/my`, and the largest page a
# client may ask for with `?limit=`. The cap exists so a history read cannot be
# unbounded.
RIDE_REQUEST_PAGE_SIZE=20
RIDE_REQUEST_MAX_PAGE_SIZE=100

# --- Dispatch and pools -----------------------------------------------------
# How long a driver has to answer an offer. Deliberately short: an offer holds
# the passenger's request and the driver's single pending slot at the same time,
# so a long one strands both. The deadline is stored on each offer, so changing
# this only affects offers made afterwards.
DISPATCH_OFFER_TTL_SECONDS=30

# Stage 1 of the driver search: the PostGIS radius (in metres) that decides which
# drivers are worth routing, and the ceiling a deliberately widened search may
# use. Distance here is straight-line, which is why it only shortlists.
DISPATCH_SHORTLIST_RADIUS_METERS=3000
DISPATCH_MAX_RADIUS_METERS=8000

# Stage 2: the routed approach a candidate will still be offered a ride over,
# in seconds. 900 s is 15 minutes; a driver slower than this is not nearby, no
# matter how close they looked on the map.
DISPATCH_MAX_APPROACH_SECONDS=900

# How old `last_seen_at` may be before a driver stops being eligible. A driver
# who has not reported in is not somewhere we can promise a passenger.
DISPATCH_LOCATION_FRESHNESS_SECONDS=300

# Ceiling for the offer and acceptance transactions, and the most candidates one
# dispatch will route.
DISPATCH_TRANSACTION_TIMEOUT_MS=15000
DISPATCH_MAX_CANDIDATES=20

# Default page size for a driver's own offer list.
DISPATCH_OFFER_PAGE_SIZE=20

# The windows the fairness terms are counted over, in seconds.
DISPATCH_REJECTION_WINDOW_SECONDS=900
DISPATCH_WORKLOAD_WINDOW_SECONDS=3600

# Scoring weights, all in seconds (see src/services/dispatch.rules.js). The score
# is "seconds away, adjusted for how this driver has behaved and how long they
# have been waiting", so these are penalties and credits in the same unit as the
# approach duration -- not arbitrary multipliers.
#
# The idle credit is capped, so a driver who has been idle for a week cannot
# outrank one who is two minutes away.
DISPATCH_REJECTION_PENALTY_SECONDS=60
DISPATCH_WORKLOAD_PENALTY_SECONDS=30
DISPATCH_IDLE_CREDIT_PER_MINUTE_SECONDS=5
DISPATCH_IDLE_CREDIT_MAX_SECONDS=180

# --- Pool-first matching ----------------------------------------------------
# A new WAITING request tries to join a pool that is already forming before it is
# offered a driver of its own (see src/services/assignment.service.js).

# How long a request is considered for an *existing* pool. A passenger who has
# already waited longer than this is not helped by somebody else's detour, so past
# this point the request goes straight to dispatch.
MATCHING_WINDOW_SECONDS=300

# Stage 1 of the pool search: how near the new pickup (and, separately, the new
# destination) has to be to a pool's *planned route* to be worth simulating.
# Straight-line metres, used only to shortlist -- the insertion simulation decides.
#
# This is a filter for cost, not a safety rule: the limits below are what protect
# a passenger. It is deliberately wider than a tight corridor would be, so that a
# passenger standing one zone off a pool's route is still simulated and judged on
# its actual detour -- the seeded Banani Road 11 <-> Mohakhali pair is 1.6 km
# apart, and a 1500 m shortlist rejected it before any rule could.
MATCHING_RADIUS_METERS=2500
MATCHING_DESTINATION_RADIUS_METERS=3000

# The rules a proposed insertion has to satisfy. All in seconds.
#
# The wait is measured from the passenger's own `requested_at`, so it includes the
# matching delay and the driver's approach: it is the time the passenger actually
# spends waiting, which is why it is the largest of the four limits.
#
# The detour limits are per *existing* passenger, measured against the duration
# their own accepted quote froze: the difference and the multiple must both pass,
# because twelve minutes means something different on a four-minute trip than on
# a forty-minute one.
#
# The ratio is DEMO TUNING and the loosest limit here on purpose. It decides
# whether two passengers leaving the same corner for two places a couple of
# kilometres apart share a car: serving both means one of them rides past their
# own destination and comes back, which is honestly about 1.6x, not 1.25x. Lower
# it for a stricter product -- the fare caps still stop anyone paying more.
MATCHING_MAX_PICKUP_WAIT_SECONDS=480
MATCHING_MAX_ADDED_DURATION_SECONDS=600
MATCHING_MAX_DETOUR_SECONDS=600
MATCHING_MAX_DETOUR_RATIO=1.75

# Scoring weights for a feasible insertion. All ones by default, which makes the
# score read as "seconds of harm this insertion does":
#
#   score = added pool duration
#         + new passenger's wait        x MATCHING_PICKUP_WAIT_WEIGHT
#         + worst existing detour       x MATCHING_DETOUR_WEIGHT
MATCHING_PICKUP_WAIT_WEIGHT=1
MATCHING_DETOUR_WEIGHT=1

# How many candidate pools one request evaluates (nearest to its pickup first),
# and the ceiling for a pool-join acceptance transaction. A join resequences the
# pool's stops and re-plans its route, so it is a longer critical section than a
# first acceptance.
MATCHING_MAX_CANDIDATE_POOLS=10
MATCHING_TRANSACTION_TIMEOUT_MS=15000

# --- Shared fares -----------------------------------------------------------
# What each passenger in a pool owes, calculated from the legs they are on board
# for (see src/services/pool-fare.rules.js).

# The shared-fare *rule version* is not configurable, and that is the point: it is
# a constant in the code, so changing the arithmetic is a reviewable code change
# that is published as a new version rather than a deployment setting that could
# silently re-price a calculation somebody was already given.

# Ceiling for a fare recalculation run on its own -- the repair sweep, rather than
# the ones that run inside an acceptance transaction (those use
# MATCHING_TRANSACTION_TIMEOUT_MS, which is the transaction they are part of).
# It has to cover routing every leg of the plan.
POOL_FARE_TRANSACTION_TIMEOUT_MS=20000

# Most pools one repair sweep will examine, so a run against a large database
# stays bounded and finishes.
POOL_FARE_MAX_POOLS_PER_SWEEP=200

# --- The driver's trip ------------------------------------------------------
# Depart, arrive, collect, start, deliver, complete: the operations that turn a
# matched pool into a driven trip. Each is a handful of row writes under locks it
# takes itself, so the ceiling only has to cover a slow database -- nothing here
# routes or prices anything.

# Ceiling for one trip command's transaction.
TRIP_TRANSACTION_TIMEOUT_MS=10000

# --- TeslaPay ----------------------------------------------------------------
# Ceiling for one settlement. It locks the payment row and then up to two wallets
# (payer, then driver), so this covers three row locks and four writes. Nothing in
# a settlement routes or prices anything, so it is a slow-database allowance
# rather than a workload one.
PAYMENT_TRANSACTION_TIMEOUT_MS=10000
