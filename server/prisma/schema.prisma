// Prisma view of the TeslaB database.
//
// ---------------------------------------------------------------------------
// BASELINE, NOT SOURCE OF TRUTH
// ---------------------------------------------------------------------------
// This schema describes a database built from the idempotent SQL files in
// server/db. Those files remain the source of truth for the physical schema;
// this file only describes it to Prisma.
//
// Consequently:
//   * `prisma migrate` is deliberately NOT used -- it would try to take
//     ownership of the schema and to drop the CHECK constraints below, which
//     Prisma does not model.
//   * the PostGIS columns are `Unsupported`, because Prisma has no spatial
//     types. They are read and written through raw SQL -- see
//     src/db/seeds/location.seed.js and src/services/location.service.js.
//
// Naming: models and fields use idiomatic Prisma casing and are mapped onto the
// existing snake_case tables/columns with @@map/@map. These names are a Prisma
// concern only -- the database itself is unchanged.

// The classic generator is used deliberately: this server is plain JavaScript
// (no build step), and it emits a JavaScript client into node_modules that is
// imported as `@prisma/client`. The newer `prisma-client` generator emits
// TypeScript only, which would require a compile step or --experimental-strip-types.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// PostGIS location foundation
// ---------------------------------------------------------------------------

/// A Dhaka service zone.
///
/// `code` is the stable seed key and must not change when `name` does, which is
/// why both are unique and the seed upserts on code.
///
/// `centerLocation` is `geography(Point, 4326)`, seeded as the centroid of the
/// zone's own points rather than a surveyed boundary. Prisma cannot model
/// spatial types, hence Unsupported.
model ServiceZone {
  id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String                   @unique
  name           String                   @unique
  active         Boolean                  @default(true)
  centerLocation Unsupported("geography") @map("center_location")
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  servicePoints  ServicePoint[]

  @@index([active])
  @@map("service_zones")
}

/// A node in the stored routing graph.
///
/// Deliberately a separate model from ServicePoint: service points are the
/// passenger-facing places people get in and out of, while vertices are what a
/// future router walks between. In this seed they are one-to-one, but the
/// separation is what will later let several points share one junction.
///
/// `graphNodeId` exists because pgRouting needs integer identifiers and this
/// table is keyed on a UUID. It is written once by the seeder (ranked from
/// `code` in byte order) and an immutability trigger rejects any later change,
/// because a returned route refers to edges by these numbers.
model RoutingVertex {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String                  @unique
  location      Unsupported("geometry")
  graphNodeId   BigInt                  @unique(map: "routing_vertices_graph_node_id_unique") @default(autoincrement()) @map("graph_node_id")
  active        Boolean                 @default(true)
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  servicePoints ServicePoint[]
  outgoingEdges RoutingEdge[]           @relation("RoutingEdgeSource")
  incomingEdges RoutingEdge[]           @relation("RoutingEdgeTarget")

  @@index([active])
  @@map("routing_vertices")
}

/// A curated pickup/drop-off location that passengers may later choose.
///
/// Always belongs to exactly one zone and always has exactly one routing
/// vertex. `(zone_id, name)` is unique so a zone cannot list the same place
/// twice; `code` is globally unique because it is both the seed key and the
/// public identifier.
model ServicePoint {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zoneId              String                   @map("zone_id") @db.Uuid
  routingVertexId     String                   @map("routing_vertex_id") @db.Uuid
  code                String                   @unique
  name                String
  location            Unsupported("geography")
  active              Boolean                  @default(true)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  zone                ServiceZone              @relation(fields: [zoneId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  routingVertex       RoutingVertex            @relation(fields: [routingVertexId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  originQuotes        FareQuote[]              @relation("FareQuoteOrigin")
  destinationQuotes   FareQuote[]              @relation("FareQuoteDestination")
  pickupRideRequests  RideRequest[]            @relation("RideRequestPickup")
  dropoffRideRequests RideRequest[]            @relation("RideRequestDropoff")
  driversAtPoint      DriverProfile[]          @relation("DriverCurrentServicePoint")
  poolStops           PoolStop[]

  @@unique([zoneId, name], map: "service_points_zone_name_unique")
  @@index([zoneId])
  @@index([routingVertexId])
  @@index([active])
  @@index([zoneId, active], map: "service_points_zone_active_idx")
  @@map("service_points")
}

/// A directed edge in the stored routing graph.
///
/// Travel from source to target is always permitted. `bidirectional` adds the
/// return leg, which is exactly why the reverse durations must be present when
/// it is true and absent when it is not -- enforced by a CHECK constraint.
///
/// `distanceMeters` is derived from the geometry with
/// ST_Length(geometry::geography); a CHECK constraint keeps the two in step.
/// Nothing here stores money: `fareWeight` is a relative weight, not a fare.
///
/// `graphEdgeId` is what pgRouting takes as the edge `id` and reports back as
/// `edge`, so it is how a returned path is mapped to rows of this table. Like
/// `RoutingVertex.graphNodeId` it is written once and immutable.
model RoutingEdge {
  id                             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                           String                  @unique
  graphEdgeId                    BigInt                  @unique(map: "routing_edges_graph_edge_id_unique") @default(autoincrement()) @map("graph_edge_id")
  sourceVertexId                 String                  @map("source_vertex_id") @db.Uuid
  targetVertexId                 String                  @map("target_vertex_id") @db.Uuid
  geometry                       Unsupported("geometry")
  distanceMeters                 Decimal                 @map("distance_meters") @db.Decimal(12, 2)
  normalDurationSeconds          Int                     @map("normal_duration_seconds")
  rushHourDurationSeconds        Int                     @map("rush_hour_duration_seconds")
  fareWeight                     Decimal                 @default(1) @map("fare_weight") @db.Decimal(6, 3)
  reverseNormalDurationSeconds   Int?                    @map("reverse_normal_duration_seconds")
  reverseRushHourDurationSeconds Int?                    @map("reverse_rush_hour_duration_seconds")
  bidirectional                  Boolean                 @default(false)
  active                         Boolean                 @default(true)
  metadata                       Json?
  createdAt                      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                      DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  sourceVertex                   RoutingVertex           @relation("RoutingEdgeSource", fields: [sourceVertexId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  targetVertex                   RoutingVertex           @relation("RoutingEdgeTarget", fields: [targetVertexId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([sourceVertexId])
  @@index([targetVertexId])
  @@index([active])
  @@map("routing_edges")
}

// ---------------------------------------------------------------------------
// Solo-fare pricing
// ---------------------------------------------------------------------------

/// One version of one solo-fare pricing policy (server/db/07-fare-pricing.sql).
///
/// Every money field is `Decimal` -- decimal.js -- because binary floating point
/// cannot hold 0.10 exactly and a fare must be reproducible. Nothing here is
/// per-ride state: this table is configuration, and it is the only place a rate
/// may come from.
///
/// `(code, version)` is the identity of a policy. A version that quotes already
/// reference cannot have its calculation inputs changed (a database trigger
/// refuses it); the next price is a new version.
model FarePolicy {
  id                      String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                    String
  version                 Int
  name                    String
  currency                String      @default("BDT")
  baseFare                Decimal     @map("base_fare") @db.Decimal(12, 4)
  perKilometerRate        Decimal     @map("per_kilometer_rate") @db.Decimal(12, 4)
  perMinuteRate           Decimal     @map("per_minute_rate") @db.Decimal(12, 4)
  minimumFare             Decimal     @map("minimum_fare") @db.Decimal(12, 4)
  normalTrafficMultiplier Decimal     @default(1.0000) @map("normal_traffic_multiplier") @db.Decimal(6, 4)
  rushHourMultiplier      Decimal     @map("rush_hour_multiplier") @db.Decimal(6, 4)
  quoteTtlSeconds         Int         @map("quote_ttl_seconds")
  roundingScale           Int         @default(2) @map("rounding_scale") @db.SmallInt
  /// The unit a charged fare is rounded to: a whole number of taka, so the
  /// price a passenger is given is never a fraction. `minimumFare` must be a
  /// whole number of units, which is what proves rounding cannot undercut it.
  fareRoundingUnit        Decimal     @default(10) @map("fare_rounding_unit") @db.Decimal(12, 4)
  active                  Boolean     @default(true)
  effectiveFrom           DateTime    @map("effective_from") @db.Timestamptz(6)
  effectiveTo             DateTime?   @map("effective_to") @db.Timestamptz(6)
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  quotes                  FareQuote[]
  poolFareCalculations    PoolFareCalculation[]

  @@unique([code, version], map: "fare_policies_code_version_unique")
  @@index([code, active, effectiveFrom])
  @@map("fare_policies")
}

/// One quoted price: immutable, expiring, and explainable after the fact.
///
/// The columns are the inputs and the outputs of the fare formula, and three
/// CHECK constraints keep the stored arithmetic self-consistent (subtotal,
/// total, and whether the minimum fare actually won), so a quote cannot be
/// written with a breakdown that does not add up.
///
/// `trafficMultiplier` is the profile's multiplier as applied -- it is stored,
/// and the total is `subtotal + trafficAdjustment`, so the multiplier can never
/// be applied twice without the row failing `fare_quotes_total_consistent`.
///
/// `passengerProfileId` is the passenger the quote was calculated for, taken
/// from authentication rather than from the request. It is nullable because
/// quotes created before that rule existed have no owner -- and "no owner" has
/// to stay distinguishable from "belongs to this passenger", since an unowned
/// quote can never be accepted by anyone.
model FareQuote {
  id                        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  originServicePointId      String            @map("origin_service_point_id") @db.Uuid
  destinationServicePointId String            @map("destination_service_point_id") @db.Uuid
  departureAt               DateTime          @map("departure_at") @db.Timestamptz(6)
  estimatedArrivalAt        DateTime          @map("estimated_arrival_at") @db.Timestamptz(6)
  trafficProfile            TrafficProfile    @map("traffic_profile")
  distanceMeters            Int               @map("distance_meters")
  durationSeconds           Int               @map("duration_seconds")
  farePolicyId              String            @map("fare_policy_id") @db.Uuid
  pricingCode               String            @map("pricing_code")
  pricingVersion            Int               @map("pricing_version")
  currency                  String
  baseFare                  Decimal           @map("base_fare") @db.Decimal(14, 6)
  distanceFare              Decimal           @map("distance_fare") @db.Decimal(14, 6)
  timeFare                  Decimal           @map("time_fare") @db.Decimal(14, 6)
  preTrafficSubtotal        Decimal           @map("pre_traffic_subtotal") @db.Decimal(14, 6)
  trafficMultiplier         Decimal           @map("traffic_multiplier") @db.Decimal(14, 6)
  trafficAdjustment         Decimal           @map("traffic_adjustment") @db.Decimal(14, 6)
  minimumFare               Decimal           @map("minimum_fare") @db.Decimal(14, 6)
  minimumFareApplied        Boolean           @map("minimum_fare_applied")
  finalFare                 Decimal           @map("final_fare") @db.Decimal(14, 6)
  /// The unit `finalFare` was rounded to (a whole number of taka). NULL only for
  /// a quote written before the rule existed; nothing writes NULL now.
  fareRoundingUnit          Decimal?          @map("fare_rounding_unit") @db.Decimal(14, 6)
  /// `finalFare` minus the fare before rounding. Signed, and at most half a unit.
  fareRoundingAdjustment    Decimal           @default(0) @map("fare_rounding_adjustment") @db.Decimal(14, 6)
  routeSnapshot             Json              @map("route_snapshot")
  fareBreakdown             Json              @map("fare_breakdown")
  expiresAt                 DateTime          @map("expires_at") @db.Timestamptz(6)
  createdAt                 DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  passengerProfileId        String?           @map("passenger_profile_id") @db.Uuid
  originServicePoint        ServicePoint      @relation("FareQuoteOrigin", fields: [originServicePointId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  destinationServicePoint   ServicePoint      @relation("FareQuoteDestination", fields: [destinationServicePointId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  farePolicy                FarePolicy        @relation(fields: [farePolicyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  passengerProfile          PassengerProfile? @relation(fields: [passengerProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rideRequest               RideRequest?

  @@index([expiresAt])
  @@index([farePolicyId])
  @@index([createdAt])
  @@index([originServicePointId, destinationServicePointId], map: "fare_quotes_endpoints_idx")
  @@index([passengerProfileId])
  @@map("fare_quotes")
}

// ---------------------------------------------------------------------------
// Ride requests
// ---------------------------------------------------------------------------

/// One passenger travelling from one pickup point to one destination point.
///
/// **There is no seat count, and there will not be one.** A request is one
/// passenger; future vehicle-capacity planning counts assigned passenger
/// requests rather than seats, so this model never has to be migrated away.
///
/// The `accepted*` columns are frozen copies of the quote -- a later FarePolicy
/// version must not change what a passenger already agreed to. A database
/// trigger makes them, and the passenger/quote/endpoints, write-once.
///
/// Three rules are enforced by the database rather than by a service, because
/// they are the ones that break under concurrency: `fareQuoteId` is unique (one
/// request per accepted quote), `(passengerProfileId, idempotencyKey)` is unique
/// (idempotent retries), and the partial unique index
/// `one_active_ride_request_per_passenger` allows exactly one active request per
/// passenger. Prisma cannot express a partial index, so that one appears as an
/// expected difference in `prisma migrate diff` -- like the GiST indexes.
model RideRequest {
  id                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  passengerProfileId      String              @map("passenger_profile_id") @db.Uuid
  fareQuoteId             String              @unique @map("fare_quote_id") @db.Uuid
  pickupServicePointId    String              @map("pickup_service_point_id") @db.Uuid
  dropoffServicePointId   String              @map("dropoff_service_point_id") @db.Uuid
  status                  RideRequestStatus   @default(WAITING)
  requestedAt             DateTime            @map("requested_at") @db.Timestamptz(6)
  searchExpiresAt         DateTime            @map("search_expires_at") @db.Timestamptz(6)
  /// When this passenger's ride began, and when it ended. Both belong to the
  /// request rather than to the pool, because a passenger is delivered while the
  /// pool may still be carrying somebody else.
  startedAt               DateTime?           @map("started_at") @db.Timestamptz(6)
  completedAt             DateTime?           @map("completed_at") @db.Timestamptz(6)
  cancelledAt             DateTime?           @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason      CancellationReason? @map("cancellation_reason")
  idempotencyKey          String              @map("idempotency_key")
  requestFingerprint      String              @map("request_fingerprint")
  acceptedFare            Decimal             @map("accepted_fare") @db.Decimal(14, 6)
  currency                String
  acceptedPricingCode     String              @map("accepted_pricing_code")
  acceptedPricingVersion  Int                 @map("accepted_pricing_version")
  acceptedDistanceMeters  Int                 @map("accepted_distance_meters")
  acceptedDurationSeconds Int                 @map("accepted_duration_seconds")
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  passengerProfile        PassengerProfile    @relation(fields: [passengerProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fareQuote               FareQuote           @relation(fields: [fareQuoteId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  pickupServicePoint      ServicePoint        @relation("RideRequestPickup", fields: [pickupServicePointId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  dropoffServicePoint     ServicePoint        @relation("RideRequestDropoff", fields: [dropoffServicePointId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  events                  RideEvent[]
  dispatchOffers          DispatchOffer[]
  poolMember              PoolMember?
  poolStops               PoolStop[]
  fareAllocations         PassengerFareAllocation[]

  @@unique([passengerProfileId, idempotencyKey], map: "ride_requests_passenger_idempotency_key_unique")
  @@index([passengerProfileId, requestedAt], map: "ride_requests_passenger_requested_at_idx")
  @@index([passengerProfileId, status, requestedAt], map: "ride_requests_passenger_status_requested_at_idx")
  @@index([status, searchExpiresAt])
  @@map("ride_requests")
}

/// Append-only lifecycle history: one row per thing that happened.
///
/// `sequence` is per request and unique, so the order events happened in is a
/// fact rather than a convention. `metadata` is audit-safe by rule -- it records
/// the transition, never the passenger; no tokens, no contact details, no free
/// text from a client.
///
/// UPDATE is refused by a trigger; DELETE is not, because a deleted passenger
/// account cascades and a future retention job would need it. Nothing in the
/// application deletes an event.
model RideEvent {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rideRequestId  String             @map("ride_request_id") @db.Uuid
  sequence       Int
  eventType      RideEventType      @map("event_type")
  actorType      RideActorType      @map("actor_type")
  actorUserId    String?            @map("actor_user_id") @db.Uuid
  previousStatus RideRequestStatus? @map("previous_status")
  newStatus      RideRequestStatus  @map("new_status")
  metadata       Json               @default("{}")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  rideRequest    RideRequest        @relation(fields: [rideRequestId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actorUser      User?              @relation(fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([rideRequestId, sequence], map: "ride_events_request_sequence_unique")
  @@map("ride_events")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  email        String    @unique
  /// Nullable on purpose: rows that predate 04-auth.sql (for example the sample
  /// users in 02-seed.sql) have no credentials. A NULL hash never authenticates.
  passwordHash String?   @map("password_hash")
  role         Role      @default(PASSENGER)
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  passengerProfile PassengerProfile?
  driverProfile    DriverProfile?
  rideEvents       RideEvent[]
  poolEvents       PoolEvent[]

  @@index([role])
  @@map("users")
}

/// Which profile a user may have follows from their role, but that rule cannot
/// be expressed as a foreign key, so it is enforced in the application service.
/// `userId` being unique is what enforces "at most one profile per user".
model PassengerProfile {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String        @unique @map("user_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fareQuotes   FareQuote[]
  rideRequests RideRequest[]

  @@map("passenger_profiles")
}

model DriverProfile {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String          @unique @map("user_id") @db.Uuid
  status                DriverStatus    @default(OFFLINE)
  /// Nullable while offline: a driver who has never gone online has no point.
  currentServicePointId String?         @map("current_service_point_id") @db.Uuid
  /// Set with the status change, so "available" always means "has a point and
  /// said when". Cleared when the driver goes offline.
  availableSince        DateTime?       @map("available_since") @db.Timestamptz(6)
  /// The last time the driver reported where they were. A stale value makes them
  /// ineligible for dispatch.
  lastSeenAt            DateTime?       @map("last_seen_at") @db.Timestamptz(6)
  /// The vehicle this driver went online with. Recorded, never guessed, so a
  /// driver with several vehicles is dispatched in the one they chose.
  activeVehicleId       String?         @map("active_vehicle_id") @db.Uuid
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vehicles              Vehicle[]
  currentServicePoint   ServicePoint?   @relation("DriverCurrentServicePoint", fields: [currentServicePointId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  activeVehicle         Vehicle?        @relation("DriverActiveVehicle", fields: [activeVehicleId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  ridePools             RidePool[]
  dispatchOffers        DispatchOffer[]

  @@index([currentServicePointId])
  @@map("driver_profiles")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Vehicle {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverId         String          @map("driver_id") @db.Uuid
  name             String
  seatCapacity     Int             @map("seat_capacity")
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  driver           DriverProfile   @relation(fields: [driverId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  activeForDrivers DriverProfile[] @relation("DriverActiveVehicle")
  ridePools        RidePool[]
  dispatchOffers   DispatchOffer[]

  @@index([driverId])
  @@map("vehicles")
}

/// These map onto the `user_role` and `driver_status` PostgreSQL enum types
/// created by server/db/04-auth.sql.
enum Role {
  PASSENGER
  DRIVER
  ADMIN

  @@map("user_role")
}

enum DriverStatus {
  OFFLINE
  AVAILABLE
  RESERVED
  ON_RIDE

  @@map("driver_status")
}

/// Maps onto the `traffic_profile` PostgreSQL enum type created by
/// server/db/07-fare-pricing.sql. The application's own constants live in
/// src/utils/time.js (TRAFFIC_PROFILE) and are the same two values.
enum TrafficProfile {
  NORMAL
  RUSH_HOUR

  @@map("traffic_profile")
}

/// The full passenger-visible lifecycle, created by 08-ride-requests.sql.
/// MATCHED, IN_PROGRESS and COMPLETED exist now so that matching and trip
/// milestones never have to alter an enum that is already in use; only the
/// WAITING transitions are implemented in this phase.
enum RideRequestStatus {
  WAITING
  MATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED

  @@map("ride_request_status")
}

/// RIDE_REQUESTED, RIDE_CANCELLED, RIDE_EXPIRED and the DRIVER_* dispatch events
/// are written today; PASSENGER_MATCHED is the match event (it already existed,
/// so it is reused rather than duplicated); the POOL_JOIN_* events and the
/// fallback belong to shared matching; the rest are reserved for the trip.
enum RideEventType {
  RIDE_REQUESTED
  RIDE_CANCELLED
  RIDE_EXPIRED
  PASSENGER_MATCHED
  RIDE_STARTED
  RIDE_COMPLETED
  PASSENGER_PICKED_UP
  PASSENGER_DROPPED_OFF
  DRIVER_OFFERED
  DRIVER_REJECTED
  DRIVER_OFFER_EXPIRED
  DRIVER_OFFER_CANCELLED
  DRIVER_ACCEPTED
  POOL_CANDIDATE_EVALUATED
  POOL_JOIN_OFFERED
  POOL_JOIN_REJECTED
  POOL_JOIN_ACCEPTED
  INITIAL_DISPATCH_FALLBACK
  PASSENGER_FARE_ALLOCATED
  PASSENGER_FARE_REDUCED
  /// The trip: the driver reached this passenger's pickup stop.
  DRIVER_ARRIVED
  /// TeslaPay: this passenger's fare for this journey was settled.
  RIDE_PAID

  @@map("ride_event_type")
}

enum RideActorType {
  PASSENGER
  SYSTEM
  ADMIN

  @@map("ride_actor_type")
}

enum CancellationReason {
  CHANGED_MIND
  WRONG_LOCATION
  WAIT_TOO_LONG
  OTHER

  @@map("ride_cancellation_reason")
}

// ---------------------------------------------------------------------------
// Driver dispatch and pools (server/db/09-driver-dispatch.sql)
// ---------------------------------------------------------------------------

/// A temporary offer of one ride request to one driver, in one vehicle.
///
/// It is the only thing that can turn a WAITING request into a pool, and it
/// expires. Two partial unique indexes make sequential dispatch a database fact
/// rather than a service convention: one PENDING initial offer per request, and
/// one PENDING initial offer per driver. Prisma cannot express a partial index,
/// so both appear in `prisma migrate diff` -- like the GiST indexes and
/// `one_active_ride_request_per_passenger`.
///
/// A database trigger freezes the driver, request, vehicle, approach route,
/// score, window and proposal, and allows the status to move PENDING -> one of
/// the four terminal states exactly once.
model DispatchOffer {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rideRequestId           String                   @map("ride_request_id") @db.Uuid
  driverProfileId         String                   @map("driver_profile_id") @db.Uuid
  vehicleId               String                   @map("vehicle_id") @db.Uuid
  /// Set by acceptance, to the pool that acceptance created. For an
  /// ADD_PASSENGER offer it is set at creation: the pool *is* the proposal.
  ridePoolId              String?                  @map("ride_pool_id") @db.Uuid
  /// The `RidePool.version` an ADD_PASSENGER proposal was planned against.
  /// Acceptance refuses an offer whose version is no longer current, which is
  /// what stops a stale plan changing a pool that has moved on.
  poolVersion             Int?                     @map("pool_version")
  offerType               DispatchOfferType        @default(INITIAL_RIDE) @map("offer_type")
  status                  DispatchOfferStatus      @default(PENDING)
  approachDistanceMeters  Decimal                  @map("approach_distance_meters") @db.Decimal(12, 2)
  approachDurationSeconds Int                      @map("approach_duration_seconds")
  /// The deterministic candidate score this offer won with, kept so a dispatch
  /// decision can be explained afterwards.
  score                   Decimal                  @db.Decimal(12, 2)
  offeredAt               DateTime                 @map("offered_at") @db.Timestamptz(6)
  expiresAt               DateTime                 @map("expires_at") @db.Timestamptz(6)
  respondedAt             DateTime?                @map("responded_at") @db.Timestamptz(6)
  rejectionReason         DispatchRejectionReason? @map("rejection_reason")
  /// What the driver was shown. Deliberately holds no passenger identity, no
  /// contact details, no money and no tokens, so the driver DTO cannot leak.
  proposalSnapshot        Json                     @map("proposal_snapshot")
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rideRequest             RideRequest              @relation(fields: [rideRequestId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  driverProfile           DriverProfile            @relation(fields: [driverProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vehicle                 Vehicle                  @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  ridePool                RidePool?                @relation(fields: [ridePoolId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([rideRequestId, offeredAt], map: "dispatch_offers_request_idx")
  @@index([driverProfileId, offeredAt], map: "dispatch_offers_driver_offered_at_idx")
  @@map("dispatch_offers")
}

/// One driver, one vehicle, one active trip.
///
/// Only `FORMING` is created in the dispatch milestone; the other statuses exist
/// so the trip milestones never alter an enum already in use, and the partial
/// unique index `one_active_pool_per_driver` already covers all of them.
///
/// `capacitySnapshot` is a copy, so a later vehicle change cannot rewrite the
/// capacity a pool was planned with. `plannedRouteGeometry` is the passenger's
/// route as stored with the quote, and is `Unsupported` because Prisma has no
/// PostGIS types (it is written through parameterised SQL).
model RidePool {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverProfileId        String                   @map("driver_profile_id") @db.Uuid
  vehicleId              String                   @map("vehicle_id") @db.Uuid
  status                 RidePoolStatus           @default(FORMING)
  capacitySnapshot       Int                      @map("capacity_snapshot")
  plannedRouteGeometry   Unsupported("geometry")? @map("planned_route_geometry")
  plannedDistanceMeters  Decimal                  @map("planned_distance_meters") @db.Decimal(12, 2)
  plannedDurationSeconds Int                      @map("planned_duration_seconds")
  /// Bumped by every accepted route-plan change (a passenger joining). A later
  /// trip milestones can use the same column for optimistic concurrency.
  version                Int                      @default(1)
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  acceptedAt             DateTime                 @default(now()) @map("accepted_at") @db.Timestamptz(6)
  driverArrivedAt        DateTime?                @map("driver_arrived_at") @db.Timestamptz(6)
  /// When the driver set off for the first pickup: set once, with the move out
  /// of FORMING, and the instant every later status is measured from.
  departedAt             DateTime?                @map("departed_at") @db.Timestamptz(6)
  startedAt              DateTime?                @map("started_at") @db.Timestamptz(6)
  completedAt            DateTime?                @map("completed_at") @db.Timestamptz(6)
  cancelledAt            DateTime?                @map("cancelled_at") @db.Timestamptz(6)
  updatedAt              DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  driverProfile          DriverProfile            @relation(fields: [driverProfileId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  vehicle                Vehicle                  @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  members                PoolMember[]
  stops                  PoolStop[]
  events                 PoolEvent[]
  dispatchOffers         DispatchOffer[]
  fareCalculations       PoolFareCalculation[]

  @@index([status])
  @@index([driverProfileId, createdAt, id], map: "ride_pools_driver_created_at_idx")
  @@index([driverProfileId, status, createdAt], map: "ride_pools_driver_status_created_at_idx")
  @@map("ride_pools")
}

/// One passenger in a pool. `rideRequestId` is UNIQUE: a ride request can join
/// at most one pool, and the member and the request describe the same journey.
/// No passenger contact data is copied here.
model PoolMember {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ridePoolId    String           @map("ride_pool_id") @db.Uuid
  rideRequestId String           @unique @map("ride_request_id") @db.Uuid
  status        PoolMemberStatus @default(ASSIGNED)
  matchedAt     DateTime         @default(now()) @map("matched_at") @db.Timestamptz(6)
  pickedUpAt    DateTime?        @map("picked_up_at") @db.Timestamptz(6)
  droppedOffAt  DateTime?        @map("dropped_off_at") @db.Timestamptz(6)
  cancelledAt   DateTime?        @map("cancelled_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  ridePool      RidePool         @relation(fields: [ridePoolId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rideRequest   RideRequest      @relation(fields: [rideRequestId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  stops         PoolStop[]
  fareAllocations PassengerFareAllocation[]

  @@index([ridePoolId])
  @@map("pool_members")
}

/// The ordered plan for a pool: sequence 1 is the pickup, sequence 2 the
/// drop-off. A trigger pins each stop to the service point the request named,
/// keeps it with its own member, and refuses a drop-off before its pickup.
model PoolStop {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ridePoolId       String         @map("ride_pool_id") @db.Uuid
  rideRequestId    String         @map("ride_request_id") @db.Uuid
  poolMemberId     String         @map("pool_member_id") @db.Uuid
  servicePointId   String         @map("service_point_id") @db.Uuid
  stopType         PoolStopType   @map("stop_type")
  sequence         Int
  status           PoolStopStatus @default(PENDING)
  plannedArrivalAt DateTime       @map("planned_arrival_at") @db.Timestamptz(6)
  actualArrivalAt  DateTime?      @map("actual_arrival_at") @db.Timestamptz(6)
  /// When the last required action at this stop finished. A stop is reached and
  /// then completed, and `pool_stops_lifecycle_consistent` refuses either
  /// without its instant.
  completedAt      DateTime?      @map("completed_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  ridePool         RidePool       @relation(fields: [ridePoolId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rideRequest      RideRequest    @relation(fields: [rideRequestId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  poolMember       PoolMember     @relation(fields: [poolMemberId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  servicePoint     ServicePoint   @relation(fields: [servicePointId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  fareLegsFrom     PoolFareLeg[]  @relation("FareLegFrom")
  fareLegsTo       PoolFareLeg[]  @relation("FareLegTo")

  @@unique([ridePoolId, sequence], map: "pool_stops_pool_sequence_unique")
  @@unique([poolMemberId, stopType], map: "pool_stops_member_type_unique")
  @@index([rideRequestId])
  @@map("pool_stops")
}

/// Append-only pool history, mirroring RideEvent: numbered per pool, with the
/// actor and a small audit-safe JSON payload. UPDATE is refused by a trigger.
model PoolEvent {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ridePoolId  String        @map("ride_pool_id") @db.Uuid
  sequence    Int
  eventType   PoolEventType @map("event_type")
  actorType   PoolActorType @map("actor_type")
  actorUserId String?       @map("actor_user_id") @db.Uuid
  metadata    Json          @default("{}")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  ridePool    RidePool      @relation(fields: [ridePoolId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actorUser   User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([ridePoolId, sequence], map: "pool_events_pool_sequence_unique")
  @@map("pool_events")
}

// ---------------------------------------------------------------------------
// Shared fares (server/db/11-pool-fares.sql)
// ---------------------------------------------------------------------------

/// One immutable, versioned answer to "what does this pool owe, and to whom?".
///
/// It is written whenever the pool's plan changes: an initial pool creates
/// version 1's calculation, and every accepted join supersedes it with the next
/// version's. The previous row is kept, so the history of what each passenger
/// was quoted at every step stays readable.
///
/// At most one row per pool is CURRENT (`one_current_pool_fare_calculation_per_pool`,
/// a partial unique index Prisma cannot model), and at most one row ever exists
/// per (pool version, rule version), which is what makes recalculation
/// idempotent. A trigger makes every amount and every version write-once: only
/// the status may move, and only CURRENT -> SUPERSEDED or CURRENT -> FINALIZED.
model PoolFareCalculation {
  id                          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ridePoolId                  String                    @map("ride_pool_id") @db.Uuid
  poolVersion                 Int                       @map("pool_version")
  pricingPolicyId             String                    @map("pricing_policy_id") @db.Uuid
  pricingCode                 String                    @map("pricing_code")
  pricingVersion              Int                       @map("pricing_version")
  sharedFareRuleVersion       String                    @map("shared_fare_rule_version")
  status                      PoolFareCalculationStatus @default(CURRENT)
  currency                    String
  trafficProfile              TrafficProfile            @map("traffic_profile")
  routeDistanceMeters         Int                       @map("route_distance_meters")
  routeDurationSeconds        Int                       @map("route_duration_seconds")
  totalVariableRouteCost      Decimal                   @map("total_variable_route_cost") @db.Decimal(14, 6)
  totalPassengerBaseFare      Decimal                   @map("total_passenger_base_fare") @db.Decimal(14, 6)
  totalUncappedPassengerFare  Decimal                   @map("total_uncapped_passenger_fare") @db.Decimal(14, 6)
  /// How much the minimum fare added across all passengers: money no passenger
  /// produced, recorded rather than hidden in a difference.
  totalMinimumFareUplift      Decimal                   @map("total_minimum_fare_uplift") @db.Decimal(14, 6)
  totalFinalPassengerFare     Decimal                   @map("total_final_passenger_fare") @db.Decimal(14, 6)
  totalSoloCapReduction       Decimal                   @map("total_solo_cap_reduction") @db.Decimal(14, 6)
  totalNoIncreaseReduction    Decimal                   @map("total_no_increase_reduction") @db.Decimal(14, 6)
  /// The sum of the per-passenger fare rounding adjustments: money the rounding
  /// to whole taka added to or took off the pool.
  totalFareRoundingAdjustment Decimal                   @default(0) @map("total_fare_rounding_adjustment") @db.Decimal(14, 6)
  /// The unit every passenger's fare was rounded to. NULL for a calculation made
  /// before the rule existed.
  fareRoundingUnit            Decimal?                  @map("fare_rounding_unit") @db.Decimal(14, 6)
  createdAt                   DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Set when the driver departs: the fare the trip is running under, frozen so
  /// that a settlement milestone has one answer to settle.
  finalizedAt                 DateTime?                 @map("finalized_at") @db.Timestamptz(6)
  ridePool                    RidePool                  @relation(fields: [ridePoolId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pricingPolicy               FarePolicy                @relation(fields: [pricingPolicyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  legs                        PoolFareLeg[]
  allocations                 PassengerFareAllocation[]

  @@unique([ridePoolId, poolVersion, sharedFareRuleVersion], map: "pool_fare_calculations_version_rule_unique")
  @@index([ridePoolId, createdAt(sort: Desc)], map: "pool_fare_calculations_pool_created_idx")
  @@map("pool_fare_calculations")
}

/// One leg of the plan: travel from one ordered PoolStop to the next.
///
/// `onboardPassengerCount` is how many passengers were in the vehicle for this
/// leg, derived from the stop actions before it. A leg with nobody on board is
/// still recorded -- the driver drove it -- but it funds nothing, so all four
/// money columns are zero; `pool_fare_legs_unfunded_is_free` enforces exactly
/// that. The driver's approach to the first pickup is not a leg at all.
///
/// `routeSnapshot` holds the rendered edges and their weights, which is what
/// makes the leg cost reproducible without asking the router again.
model PoolFareLeg {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fareCalculationId     String              @map("fare_calculation_id") @db.Uuid
  sequence              Int
  fromPoolStopId        String              @map("from_pool_stop_id") @db.Uuid
  toPoolStopId          String              @map("to_pool_stop_id") @db.Uuid
  distanceMeters        Int                 @map("distance_meters")
  durationSeconds       Int                 @map("duration_seconds")
  distanceCost          Decimal             @map("distance_cost") @db.Decimal(14, 6)
  timeCost              Decimal             @map("time_cost") @db.Decimal(14, 6)
  trafficAdjustment     Decimal             @map("traffic_adjustment") @db.Decimal(14, 6)
  totalLegCost          Decimal             @map("total_leg_cost") @db.Decimal(14, 6)
  onboardPassengerCount Int                 @map("onboard_passenger_count")
  routeSnapshot         Json                @map("route_snapshot")
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  fareCalculation       PoolFareCalculation @relation(fields: [fareCalculationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fromPoolStop          PoolStop            @relation("FareLegFrom", fields: [fromPoolStopId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  toPoolStop            PoolStop            @relation("FareLegTo", fields: [toPoolStopId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  shares                PassengerFareLegShare[]

  @@unique([fareCalculationId, sequence], map: "pool_fare_legs_sequence_unique")
  @@index([fromPoolStopId])
  @@map("pool_fare_legs")
}

/// What one member owes in one calculation, with every step of the capping
/// written down: the accepted solo fare, the previous pooled fare that caps it,
/// the shares they were given, and the two reductions.
///
/// The database enforces the guarantees rather than trusting the service:
/// `finalFare <= acceptedSoloFare` always, `finalFare <= previousPooledFareCap`
/// whenever there is one, and
/// `finalFare + soloCapReduction + noIncreaseReduction = max(minimumFare, uncappedPooledFare)`
/// so nothing is lost or created by a cap.
model PassengerFareAllocation {
  id                       String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fareCalculationId        String              @map("fare_calculation_id") @db.Uuid
  poolMemberId             String              @map("pool_member_id") @db.Uuid
  rideRequestId            String              @map("ride_request_id") @db.Uuid
  acceptedSoloFare         Decimal             @map("accepted_solo_fare") @db.Decimal(14, 6)
  /// The fare this passenger was given by the preceding pool version's
  /// calculation. Null for a passenger who has just joined.
  previousPooledFareCap    Decimal?            @map("previous_pooled_fare_cap") @db.Decimal(14, 6)
  baseFare                 Decimal             @map("base_fare") @db.Decimal(14, 6)
  allocatedLegCost         Decimal             @map("allocated_leg_cost") @db.Decimal(14, 6)
  uncappedPooledFare       Decimal             @map("uncapped_pooled_fare") @db.Decimal(14, 6)
  minimumFare              Decimal             @map("minimum_fare") @db.Decimal(14, 6)
  minimumFareApplied       Boolean             @map("minimum_fare_applied")
  soloCapApplied           Boolean             @map("solo_cap_applied")
  noIncreaseCapApplied     Boolean             @map("no_increase_cap_applied")
  soloCapReduction         Decimal             @map("solo_cap_reduction") @db.Decimal(14, 6)
  noIncreaseReduction      Decimal             @map("no_increase_reduction") @db.Decimal(14, 6)
  finalFare                Decimal             @map("final_fare") @db.Decimal(14, 6)
  /// The unit `finalFare` was rounded to, denormalised from the policy so this
  /// row can prove its own divisibility: a CHECK cannot read another table.
  fareRoundingUnit         Decimal?            @map("fare_rounding_unit") @db.Decimal(14, 6)
  /// `finalFare` minus this passenger's fare before rounding. Signed, and at
  /// most half a unit.
  fareRoundingAdjustment   Decimal             @default(0) @map("fare_rounding_adjustment") @db.Decimal(14, 6)
  currency                 String
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  fareCalculation          PoolFareCalculation @relation(fields: [fareCalculationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  poolMember               PoolMember          @relation(fields: [poolMemberId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rideRequest              RideRequest         @relation(fields: [rideRequestId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  shares                   PassengerFareLegShare[]

  @@unique([fareCalculationId, poolMemberId], map: "passenger_fare_allocations_member_unique")
  @@index([rideRequestId, createdAt(sort: Desc)], map: "passenger_fare_allocations_request_idx")
  @@map("passenger_fare_allocations")
}

/// One passenger's share of one leg.
///
/// `shareRatio` is 1/N, `unroundedAmount` the exact quotient, `allocatedAmount`
/// what they were charged, and `roundingAdjustment` the residual that made the
/// shares add up to the leg's cost exactly. A deferred constraint trigger checks
/// that sum, and that there is one share per passenger on board, at commit.
model PassengerFareLegShare {
  id                         String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  passengerFareAllocationId  String                   @map("passenger_fare_allocation_id") @db.Uuid
  poolFareLegId              String                   @map("pool_fare_leg_id") @db.Uuid
  onboardPassengerCount      Int                      @map("onboard_passenger_count")
  shareRatio                 Decimal                  @map("share_ratio") @db.Decimal(14, 10)
  unroundedAmount            Decimal                  @map("unrounded_amount") @db.Decimal(20, 10)
  allocatedAmount            Decimal                  @map("allocated_amount") @db.Decimal(14, 6)
  /// What rounding added to (or took off) the exact quotient, at ten decimals.
  roundingAdjustment         Decimal                  @map("rounding_adjustment") @db.Decimal(20, 10)
  createdAt                  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  allocation                 PassengerFareAllocation  @relation(fields: [passengerFareAllocationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  leg                        PoolFareLeg              @relation(fields: [poolFareLegId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([passengerFareAllocationId, poolFareLegId], map: "passenger_fare_leg_shares_leg_unique")
  @@index([poolFareLegId])
  @@map("passenger_fare_leg_shares")
}

/// CURRENT is what the pool owes now; SUPERSEDED is a previous answer, kept for
/// audit; FINALIZED is the answer the trip is running under, frozen at departure
/// so that nothing can re-price a journey that has begun.
enum PoolFareCalculationStatus {
  CURRENT
  SUPERSEDED
  FINALIZED

  @@map("pool_fare_calculation_status")
}

enum DispatchOfferType {
  INITIAL_RIDE
  ADD_PASSENGER

  @@map("dispatch_offer_type")
}

enum DispatchOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED

  @@map("dispatch_offer_status")
}

enum DispatchRejectionReason {
  TOO_FAR
  UNAVAILABLE
  VEHICLE_ISSUE
  OTHER

  @@map("dispatch_rejection_reason")
}

enum RidePoolStatus {
  FORMING
  DRIVER_EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("ride_pool_status")
}

enum PoolMemberStatus {
  ASSIGNED
  PICKED_UP
  DROPPED_OFF
  CANCELLED
  NO_SHOW

  @@map("pool_member_status")
}

enum PoolStopType {
  PICKUP
  DROPOFF

  @@map("pool_stop_type")
}

enum PoolStopStatus {
  PENDING
  ARRIVED
  COMPLETED
  SKIPPED

  @@map("pool_stop_status")
}

enum PoolEventType {
  POOL_CREATED
  MEMBER_ADDED
  ROUTE_PLAN_CREATED
  JOIN_PLAN_CREATED
  ROUTE_PLAN_UPDATED
  MEMBER_PICKED_UP
  MEMBER_DROPPED_OFF
  SHARED_FARE_CALCULATED
  SHARED_FARE_SUPERSEDED
  /// The trip: setting off, reaching a stop, starting, finishing and releasing
  /// the driver. `POOL_STATUS_CHANGED` and `POOL_CANCELLED` stay reserved --
  /// every transition this milestone performs has an event of its own.
  DRIVER_DEPARTED
  STOP_ARRIVED
  TRIP_STARTED
  TRIP_COMPLETED
  DRIVER_AVAILABLE
  POOL_STATUS_CHANGED
  POOL_CANCELLED

  @@map("pool_event_type")
}

enum PoolActorType {
  PASSENGER
  DRIVER
  SYSTEM
  ADMIN

  @@map("pool_actor_type")
}
