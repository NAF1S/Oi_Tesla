# ---------------------------------------------------------------------------
# docker-compose.yml reads this file. Copy it to `.env`:
#
#     cp .env.example .env
#
# Only JWT_SECRET has no usable default, and the stack refuses to start without
# it rather than inventing one.
#
# Everything else the API can be tuned with lives in server/.env.example -- that
# file documents the routing, fare and dispatch settings, and its defaults are
# used when nothing sets them. Add any of them to the `api` service's
# environment in docker-compose.yml if you need to change one.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=TeslaB

# Host port the database is published on, for psql from outside. Bound to
# 127.0.0.1, so it is not reachable from another machine. 55432 by default
# because 5432 is often already held by a local PostgreSQL service.
POSTGRES_PORT=55432

# Passed to the server. The defaults are sized for a small instance that is also
# running the API and the client; give shared_buffers more if the database has
# the machine to itself.
POSTGRES_SHARED_BUFFERS=96MB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAX_CONNECTIONS=50

# --- Sessions --------------------------------------------------------------
# REQUIRED. The API refuses to start with NODE_ENV=production unless this is
# set, and there is no fallback: a signing key with a default is a signing key
# an attacker already has. Generate one with:
#
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
JWT_SECRET=

AUTH_TOKEN_TTL_SECONDS=7200

# Leave this false while the stack is served over plain HTTP. A Secure cookie is
# not sent over HTTP, so signing in would appear to succeed and then every
# request after it would be anonymous -- a confusing failure to debug. Set it to
# true as soon as there is TLS in front of the stack.
COOKIE_SECURE=false

# --- Addresses -------------------------------------------------------------
# Where the client is reachable, for CORS.
CLIENT_ORIGIN=http://localhost:3000

# Host port the client is published on. This is the only port that needs to be
# open in a security group; 3000 is also its port inside the container.
WEB_PORT=3000

# --- Demo data -------------------------------------------------------------
# The seeder refuses to create the demo cast under NODE_ENV=production unless it
# is told to, and docker-compose.yml tells it (ALLOW_DEMO_SEED). This is the
# password Nusrat, Rafiq, Shirin and Jashim sign in with.
#
# It is a password in a file the repository ships, so: change it, or delete the
# `seed` service from docker-compose.yml, before this carries anything real.
DEMO_SEED_PASSWORD=DemoPass123!

# Work factor for password hashing. Every +1 doubles the time and cost.
BCRYPT_COST=10

# --- Background jobs -------------------------------------------------------
# How often the sweeper expires stale ride requests and retries waiting ones.
SWEEP_INTERVAL_SECONDS=30

