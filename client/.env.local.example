# Copy to .env.local and adjust as needed

# Browser-side base URL. Leave empty to use same-origin requests that Next.js
# proxies to the Express API via the rewrite in next.config.mjs.
NEXT_PUBLIC_API_URL=

# Where the Express API actually runs (used by server components and the dev proxy).
API_URL=http://localhost:4000

# Target used by the Next.js /api rewrite.
API_PROXY_TARGET=http://localhost:4000
